<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:jaxrs="http://cxf.apache.org/jaxrs"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.0.xsd
         http://cxf.apache.org/jaxrs http://cxf.apache.org/schemas/jaxrs.xsd">

    <import resource="classpath:META-INF/cxf/cxf.xml"/>
    <bean class="org.springframework.context.support.PropertySourcesPlaceholderConfigurer"/>
    <bean class="org.springframework.beans.factory.config.PreferencesPlaceholderConfigurer"/>

    <jaxrs:server id="bankservice" address="/banks">
        <jaxrs:serviceBeans>
            <ref bean="bankServiceBean"/>
        </jaxrs:serviceBeans>
    </jaxrs:server>

    <jaxrs:server id="accountservice" address="/accounts">
        <jaxrs:serviceBeans>
            <ref bean="accServiceBean"/>
        </jaxrs:serviceBeans>
    </jaxrs:server>

    <jaxrs:server id="paymentService" address="/payments">
        <jaxrs:serviceBeans>
            <ref bean="payServiceBean"/>
        </jaxrs:serviceBeans>
    </jaxrs:server>

    <jaxrs:server id="fundsConfirmationService" address="/fundsConfirmation">
        <jaxrs:serviceBeans>
            <ref bean="fundsConfServiceBean"/>
        </jaxrs:serviceBeans>
    </jaxrs:server>

    <jaxrs:server id="bankaccountservice" address="/bankaccounts">
        <jaxrs:serviceBeans>
            <ref bean="bankAccountServiceBean"/>
        </jaxrs:serviceBeans>
    </jaxrs:server>

    <bean id="bankServiceBean" class="com.wso2.openbanking.fdx.demo.backend.services.BankService"/>
    <bean id="accServiceBean" class="com.wso2.openbanking.fdx.demo.backend.services.AccountService"/>
    <bean id="fundsConfServiceBean" class="com.wso2.openbanking.fdx.demo.backend.services.FundsConfirmationService"/>
    <bean id="payServiceBean" class="com.wso2.openbanking.fdx.demo.backend.services.PaymentService"/>
    <bean id="bankAccountServiceBean" class="com.wso2.openbanking.fdx.demo.backend.services.BankAccountService"/>


</beans>

